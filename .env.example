# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- LLM (Qwen / Alibaba Cloud DashScope) — required for /chat ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Weather (OpenWeatherMap) — required for /weather and disease weather_risk ---
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# --- Computer Vision (HuggingFace Inference API) — NOT YET USED, disease/analyze uses a mock ---
HF_API_KEY=
HF_CV_MODEL_ID=

# --- Speech (stretch goal, not yet implemented) ---
SPEECH_API_KEY=

# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# --- Production reference (Railway) ---
# Live backend: https://kisan-dost-ai-production.up.railway.app